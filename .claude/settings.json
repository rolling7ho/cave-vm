      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(cargo publish:*)",
      "Bash(cargo yank:*)",
      "Bash(cargo owner:*)",
      "Bash(cargo login:*)"
    ]
  }
