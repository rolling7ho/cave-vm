#!/bin/busybox sh
# Spike initramfs init: mount the basics and start a shell on the console.
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
# cave-vmm-spike times boot to this line.
echo "cave-spike: shell ready"
exec setsid cttyhack sh
